# Copie para secrets.toml (mesma pasta) para usar o banco do Supabase no PC.
# No Streamlit Cloud, cole este mesmo conteudo em Settings > Secrets.
# Sem este arquivo o app continua usando gastos.csv e config.json.
[supabase]
url = "https://SEU-PROJETO.supabase.co"
key = "CHAVE service_role (ou secret key sb_secret_...) do projeto"

# --- Login Google (opcional) ---------------------------------------------
# Sem a secao [auth] o app abre sem login (uso no PC).
# Com ela, so entram os e-mails listados em [acesso].
[auth]
redirect_uri = "https://SEU-APP.streamlit.app/oauth2callback"   # no PC: http://localhost:8501/oauth2callback
cookie_secret = "texto aleatorio longo"

[auth.google]
client_id = "....apps.googleusercontent.com"
client_secret = "..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[acesso]
donos = ["seu-email@gmail.com"]   # veem e alteram tudo
leitores = []                      # so veem
