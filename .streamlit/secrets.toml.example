# Copie para secrets.toml (mesma pasta) para usar o banco do Supabase no PC.
# No Streamlit Cloud, cole este mesmo conteudo em Settings > Secrets.
# Sem este arquivo o app continua usando gastos.csv e config.json.
[supabase]
url = "https://SEU-PROJETO.supabase.co"
key = "CHAVE service_role (ou secret key sb_secret_...) do projeto"
